# 密钥与本地配置 —— 严禁进镜像
.env
.env.*
!.env.example

# Python 缓存与依赖
**/__pycache__/
*.pyc
**/.venv/
venv/

# 数据库（含 worlds.db）
*.db
*.sqlite

# RAG 索引（构建产物）

# 前端依赖与构建缓存（frontend/dist 由 Dockerfile Stage-1 npm run build 在镜像内生成；
# 工作区的 dist 是本地构建产物，忽略之，避免把旧构建带进镜像）
node_modules/
frontend/.vite/
frontend/dist/

# 素材大文件（脚本 OCR 等）
materials/script_ocr/

# VCS / IDE
.git
.gitignore
.vscode/
*.swp

# 临时/备份
*.log
*.bak
*.bak*
deploy.tar.gz
