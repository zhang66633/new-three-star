# 密钥与本地配置 —— 严禁进镜像
.env
.env.*
!.env.example

# Python 缓存与依赖
**/__pycache__/
*.pyc
**/.venv/
venv/

# 数据库（含 worlds.db）
*.db
*.sqlite

# RAG 索引（构建产物）
backend/knowledge/rag_index.pkl

# 前端依赖与构建缓存（注意：frontend/dist 是 Dockerfile 的 COPY 源，不能忽略）
node_modules/
frontend/.vite/

# 素材大文件（脚本 OCR 等）
materials/script_ocr/

# VCS / IDE
.git
.gitignore
.vscode/
*.swp

# 临时/备份
*.log
*.bak
*.bak*
deploy.tar.gz
