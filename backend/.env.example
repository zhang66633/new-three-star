# DeepSeek API
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Hy3 TokenHub (备用)
HY3_API_KEY=
HY3_BASE_URL=
HY3_MODEL=

# 火山引擎 ARK（氛围图生成脚本用，勿提交真实密钥）
ARK_API_KEY=

# CORS 白名单（逗号分隔，生产改成你的前端域名）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 速率限制（每 IP 窗口最大请求数）
RATE_LIMIT=30
RATE_WINDOW=60
